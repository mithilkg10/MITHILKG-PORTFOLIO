      },
      "rule": {
        "id": "91816",
        "description": "Powershell script querying system environment variables",
        "level": 4,
        "mitre": {
          "id": [
            "T1082"
          ],
          "tactic": [
            "Discovery"
          ],
          "technique": [
            "System Information Discovery"
          ]
        }
      },
      "windows": {
        "eventID": "4104",
        "eventRecordID": "2493",
        "scriptBlockText": "$ErrorActionPreference = 'Stop' $start = Get-Date $account = 'CyberLab_Ph3_NoUser' $attempts = 6 $secure = ConvertTo-SecureString '<synthetic-redacted>' -AsPlainText -Force $credential = [pscredential]::new(\\\"$env:COMPUTERNAME\\\\$account\\\", $secure) for ($i = 1; $i -le $attempts; $i++) {   try {     $process = Start-Process cmd.exe -ArgumentList '/c','exit 0' -Credential $credential -LoadUserProfile -PassThru -ErrorAction Stop     $process.WaitForExit()     throw 'Synthetic nonexistent account unexpectedly authenticated'   } catch {     if ($_.Exception.Message -eq 'Synthetic nonexistent account unexpectedly authenticated') { throw }   }   Start-Sleep -Seconds 1 } Start-Sleep -Seconds 2 $events = foreach ($event in Get-WinEvent -FilterHashtable @{ LogName='Security'; Id=4625; StartTime=$start } -ErrorAction SilentlyContinue) {   [xml]$xml = $event.ToXml()   $fields = @{}   foreach ($item in $xml.Event.EventData.Data) { $fields[$item.Name] = [string]$item.'#text' }   if ($fields.TargetUserName -eq $account) {     [ordered]@{       event_id = 4625       record_id = $event.RecordId       timestamp_utc = $event.TimeCreated.ToUniversalTime().ToString('o')       target_account = $fields.T"
      }
    },
